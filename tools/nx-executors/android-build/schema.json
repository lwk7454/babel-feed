{
  "$schema": "http://json-schema.org/schema",
  "cli": "nx",
  "title": "Android Build Executor",
  "description": "Build Android application using Gradle",
  "type": "object",
  "properties": {
    "buildType": {
      "type": "string",
      "description": "Build type (debug or release)",
      "default": "debug",
      "enum": ["debug", "release"]
    },
    "gradleOptions": {
      "type": "array",
      "description": "Additional Gradle options",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "outputPath": {
      "type": "string",
      "description": "Output path for the build artifacts",
      "default": "dist"
    }
  },
  "required": []
}