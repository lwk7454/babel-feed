{
  "name": "babel-feed",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "tauri": "tauri",
    "dev": "nx run-many --target=dev --projects=babel-mobile,babel-api --parallel",
    "dev:mobile": "nx dev babel-mobile",
    "dev:api": "nx dev babel-api",
    "build:api": "nx build babel-api",
    "build:mobile": "cd apps/babel-mobile && ./scripts/build.sh --debug",
    "build:mobile:release": "cd apps/babel-mobile && ./scripts/build.sh --release",
    "build:mobile:clean": "cd apps/babel-mobile && ./scripts/build.sh --clean --debug",
    "test:e2e": "cd apps/babel-mobile && HEADED_MODE=true ./scripts/setup-android.sh && bunx wdio run wdio.conf.js",
    "test:e2e:ci": "cd apps/babel-mobile && HEADED_MODE=false ./scripts/setup-android.sh && bunx wdio run wdio.conf.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.10",
    "@angular/common": "^19.2.10",
    "@angular/compiler": "^19.2.10",
