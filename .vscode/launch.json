{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug Bun Tests",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "watchMode": false,
      "internalConsoleOptions": "openOnSessionStart",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "bun",
      "request": "launch", 
      "name": "Debug Babel API Tests",
      "program": "${workspaceFolder}/apps/babel-api/src/tests/index.test.ts",
      "cwd": "${workspaceFolder}/apps/babel-api",
      "stopOnEntry": false,
      "args": ["--watch"]
    }
  ]
}