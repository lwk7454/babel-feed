FROM docker.io/node:lts-alpine

ENV HOST=0.0.0.0
ENV PORT=3000

WORKDIR /app

RUN addgroup --system elysia-api && \
          adduser --system -G elysia-api elysia-api

COPY dist/apps/elysia-api elysia-api/
