{
  "name": "babel-feed",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nx run-many --target=dev --projects=babel-api,babel-android --parallel",
    "dev:api": "bun scripts/start-dev-db.ts && nx dev babel-api",
    "dev:android": "nx dev babel-android",
    "build": "nx run-many --target=build --projects=babel-api,babel-android --parallel",
    "build:api": "nx build babel-api",
    "build:aggregator": "nx build news-aggregator",
    "build:android": "nx build babel-android",
    "build:android:release": "nx build babel-android --configuration=production",
    "assemble:android": "nx assemble babel-android",
    "install:android": "nx install babel-android",
    "test:android": "nx test babel-android",
    "lint:android": "nx lint babel-android",
    "test:all": "nx run-many --target=test --all",
    "test:appium": "nx test appium-tests",
    "test:e2e": "bun run build:android && bun run install:android && bun run test:appium",
    "test:e2e:dev": "bun run dev:android & sleep 30 && bun run test:appium",
    "test:e2e:local": "bun run build:android && bun run install:android && bun run test:appium",
    "test:api": "nx test babel-api",
    "test:api:watch": "nx test:watch babel-api",
    "test:aggregator": "nx test news-aggregator",
    "test:aggregator:watch": "nx test:watch news-aggregator",
    "db:migrate": "bunx drizzle-kit migrate --config=packages/pgdb/drizzle.config.cjs",
    "db:generate": "bunx drizzle-kit generate --config=packages/pgdb/drizzle.config.cjs"
  },
  "private": true,
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/stream": "^1.1.0",
    "@elysiajs/swagger": "^1.3.0",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.2",
    "cheerio": "1.1.0",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.44.2",
    "elysia": "^1.3.3",
    "entities": "^6.0.1",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^10.2.3",
    "node-cron": "^3.0.3",
    "openai": "^5.6.0",
    "postgres": "^3.4.7",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "^21.1.2",
    "@nx/esbuild": "21.1.2",
    "@nx/eslint": "21.1.2",
    "@nx/eslint-plugin": "21.1.2",
    "@nx/js": "21.1.2",
    "@nx/node": "^21.1.2",
    "@nx/workspace": "^21.1.2",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "~18.16.9",
    "@types/node-cron": "^3.0.11",
    "@types/tldjs": "^2.3.4",
    "appium": "^2.11.1",
    "appium-flutter-driver": "^2.4.0",
    "appium-uiautomator2-driver": "^4.2.4",
    "bun-types": "latest",
    "esbuild": "^0.19.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "nx": "^21.1.2",
    "prettier": "^2.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.19.0",
    "webdriverio": "^8.43.0"
  },
  "nx": {}
}
