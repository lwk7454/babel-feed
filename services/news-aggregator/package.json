{
  "name": "babel-feed-news-aggregator",
  "version": "0.1.0",
  "type": "module",
  "description": "News aggregation and translation service for Babel Feed",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir=dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "postgres": "^3.4.7",
    "drizzle-orm": "^0.44.2",
    "openai": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}