{
  "$schema": "http://json-schema.org/schema",
  "cli": "nx",
  "title": "Android Test Executor",
  "description": "Run Android tests and linting",
  "type": "object",
  "properties": {
    "testType": {
      "type": "string", 
      "description": "Type of tests to run",
      "default": "unit",
      "enum": ["unit", "instrumented", "all"]
    },
    "gradleOptions": {
      "type": "array",
      "description": "Additional Gradle options",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": []
}