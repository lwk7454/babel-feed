    "@primeng/themes": "^19.1.2",
    "@tauri-apps/api": "^1.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "elysia": "^1.3.3",
    "primeflex": "^4.0.0",
    "primeicons": "^6.0.1",
    "primeng": "^19.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
