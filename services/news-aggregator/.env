# OpenRouter API Configuration (Required)
# Get your free API key from: https://openrouter.ai/
OPENROUTER_API_KEY=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

# Database Configuration
# Should match your main Babel Feed app database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=babel_feed_dev
DB_USER=babel_dev
DB_PASSWORD=babel_dev_password

# Aggregation Settings (Optional)
# How often to run aggregation (in minutes)
AGGREGATION_INTERVAL=30

# Number of articles to process in each batch
BATCH_SIZE=10

# Maximum articles to fetch per news provider
MAX_ARTICLES_PER_PROVIDER=20

# Debug mode (set to true for verbose logging)
DEBUG=false