{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Babel Mobile",
  "version": "0.1.0",
  "identifier": "com.babelmobile.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "nx serve babel-mobile",
    "beforeBuildCommand": "nx build babel-mobile"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "width": 400,
        "height": 800,
        "resizable": true,
        "fullscreen": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "News",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    }
  }
}
