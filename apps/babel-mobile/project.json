{
  "name": "babel-mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/babel-mobile/src",
  "root": "apps/babel-mobile",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/babel-mobile-ng"],
      "options": {
        "command": "ng build babel-mobile-ng",
        "cwd": "apps/babel-mobile"
      },
      "configurations": {
        "production": {
          "command": "ng build babel-mobile-ng --configuration production"
        },
        "development": {
          "command": "ng build babel-mobile-ng --configuration development"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve babel-mobile-ng",
        "cwd": "apps/babel-mobile"
      },
      "configurations": {
        "production": {
          "command": "ng serve babel-mobile-ng --configuration production"
        },
        "development": {
          "command": "ng serve babel-mobile-ng --configuration development"
        }
      },
      "defaultConfiguration": "development"
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tauri android dev",
        "cwd": "apps/babel-mobile"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng build babel-mobile-ng --watch --configuration development",
        "cwd": "apps/babel-mobile"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/babel-mobile/**/*.ts",
          "apps/babel-mobile/**/*.html"
        ]
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx wdio run wdio.conf.js",
        "cwd": "apps/babel-mobile"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/babel-mobile"]
    },
    "e2e:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx wdio run wdio.mobile.conf.js",
        "cwd": "apps/babel-mobile"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/babel-mobile"]
    }
  },
  "implicitDependencies": []
} 