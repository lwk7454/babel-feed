<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BabelFeed" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Force dark mode -->
        <item name="android:forceDarkAllowed">true</item>
        <!-- Status bar - dark background with light text -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navigation bar - dark background with light icons -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Window background -->
        <item name="android:windowBackground">#FF121212</item>
        <!-- Window flags for edge-to-edge -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>